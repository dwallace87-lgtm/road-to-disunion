  "lessons": [
    {
      "id": "L1",
      "day": 1,
      "week": 1,
      "title": "A Nation Divided: Understanding Sectionalism",
      "skill": "Historical context and chronology",
      "learning_target": "I can explain how westward expansion and slavery intensified sectional tensions.",
      "must_do": "Watch an introductory 5-minute video; revisit the Missouri Compromise and Manifest Destiny; complete a sectionalism timeline and map.",
      "should_do": "Analyze Document M, Lincoln’s House Divided speech.",
      "aspire_to_do": "Predict which sectional disagreement would prove most difficult to resolve, with evidence.",
      "assessment": "Formative check: one claim supported by a historical fact.",
      "mastery_gate": null
    },
    {
      "id": "L2",
      "day": 2,
      "week": 1,
      "title": "Slavery, Cotton, and the American Economy",
      "skill": "Interpreting maps, charts, and economic evidence",
      "learning_target": "I can explain how slavery shaped economic differences and interests between regions.",
      "must_do": "Watch a short video; analyze Document A (railroads, cotton, and enslaved population) and Document B (Union/Confederate resources).",
      "should_do": "Examine Document D, James Hammond’s Cotton Is King argument.",
      "aspire_to_do": "Evaluate whether cotton production gave the South an economic advantage or vulnerability.",
      "assessment": "Mastery Check 1 follows this lesson.",
      "mastery_gate": "MC1"
    },
    {
      "id": "L3",
      "day": 3,
      "week": 1,
      "title": "Western Expansion and Political Crisis",
      "skill": "Historical causation and relationships",
      "learning_target": "I can explain how political decisions about slavery’s expansion increased sectional tensions.",
      "must_do": "Watch a short video; analyze Document J (Kansas–Nebraska Act map) and Document L (Dred Scott decision).",
      "should_do": "Interpret Document K, political cartoon about the caning of Charles Sumner.",
      "aspire_to_do": "Argue which political decision most intensified the conflict over slavery.",
      "assessment": "Mastery Check 2 follows this lesson.",
      "mastery_gate": "MC2"
    },
    {
      "id": "L4",
      "day": 4,
      "week": 2,
      "title": "Abolitionists and Defenders of Slavery",
      "skill": "Sourcing, perspective, and author’s purpose",
      "learning_target": "I can identify an author’s argument and explain how historical context and perspective shaped it.",
      "must_do": "Compare Document G (Frederick Douglass) and Document H (George Fitzhugh’s proslavery writing), with contextual notes and guided sourcing questions.",
      "should_do": "Examine Document I, reactions to John Brown’s raid.",
      "aspire_to_do": "Explain how the authors’ intended audiences influenced their arguments.",
      "assessment": "Formative source comparison and reliability practice.",
      "teaching_note": "Analyze slavery accurately; proslavery arguments are historical propaganda, not morally equivalent interpretations.",
      "mastery_gate": null
    },
    {
      "id": "L5",
      "day": 5,
      "week": 2,
      "title": "The Election of 1860 and Secession",
      "skill": "Historical context and source reliability",
      "learning_target": "I can use historical evidence to explain secession and assess how an author’s perspective affects a source’s reliability for a particular purpose.",
      "must_do": "Analyze Document N (Election of 1860 map) and a short original excerpt from Mississippi’s 1861 Declaration of Secession.",
      "must_do_source_url": "https://www.mshistorynow.mdah.ms.gov/issue/a-declaration-of-the-immediate-causes-which-induce-and-justify-the-secession-of-the-state-of-mississippi-from-the-federal-union",
      "should_do": "Compare Document E (Calhoun’s compact theory) and Document F (Lincoln on the Union).",
      "aspire_to_do": "Explain the relationship between states’ rights arguments and the protection of slavery.",
      "assessment": "Mastery Check 3 follows this lesson.",
      "mastery_gate": "MC3"
    },
    {
      "id": "L6",
      "day": 6,
      "week": 2,
      "title": "Final Assessment: What Caused the Civil War?",
      "skill": "Synthesis, evidence-based claims, and historical reasoning",
      "learning_target": "I can explain the contribution of disagreements over slavery to the outbreak of the Civil War using evidence from at least two sources.",
      "must_do": "Individually answer four stimulus-based multiple-choice questions and write one short argument using at least two documents. Offer R/A – C/E #1 – C/E #2 scaffold if needed.",
      "should_do": null,
      "aspire_to_do": null,
      "assessment": "Final assessment: one developed paragraph, NOT a full DBQ essay.",
      "writing_prompt": "Explain how disagreements over slavery contributed to the outbreak of the Civil War. Use evidence from at least two historical sources.",
      "mastery_gate": "FINAL_ASSESSMENT"
    },
    {
      "id": "L7",
      "day": 7,
      "week": 2,
      "title": "Feedback, Revision, and Reassessment",
      "skill": "Strengthening historical reasoning and addressing misconceptions",
      "learning_target": "I can strengthen historical reasoning using feedback and demonstrate improvement on an unmet skill.",
      "must_do": "Review available feedback; complete targeted correction, short teacher conference, or reassessment on any unmet skill.",
      "should_do": "Revise the final argument using stronger evidence and explanation.",
      "aspire_to_do": "Distinguish long-term causes from immediate triggers, or preview emancipation during the war.",
      "assessment": "Individualized learning pathways: targeted revision and reassessment.",
      "mastery_gate": null
    }
  ],
